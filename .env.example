# Copy this file to .env and fill in real values. .env is gitignored.

# Required — your Anthropic API key (used for the discovery/LLM loop only;
# replay never calls the model).
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if your key is scoped to a specific workspace.
ANTHROPIC_WORKSPACE_ID=

# Credentials for the target application (mock bank portal in this repo).
# Read at runtime from env only — never hardcoded in source, never written
# into artifacts or logs (guardrails.redact() scrubs the password value from
# any string before it is persisted).
BANK_USERNAME=j.martinez
BANK_PASSWORD=REDACTED_PASSWORD
